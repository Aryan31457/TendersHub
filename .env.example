# ==============================================================================
# India eProcurement Tenders Hub - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Target Portal URL (Active Tenders View)
TARGET_URL=https://etenders.gov.in/eprocure/app?page=FrontEndLatestActiveTenders&service=page

# Default Pagination Limit (0 = scrape all available records across all pages)
MAX_PAGES=0

# AI CAPTCHA Provider: 'gemini' (Recommended) or 'qwen'
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Configuration (Get your API key at: https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ------------------------------------------------------------------------------
# Alibaba Qwen Configuration (Optional, OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-v1
QWEN_MODEL=qwen-vl-max

# ------------------------------------------------------------------------------
# Email Alert Notifications (Optional - uses Gmail SMTP with 16-character App Password)
# ------------------------------------------------------------------------------
ALERT_EMAIL=your_sender_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
RECEIVER_EMAIL=your_recipient_email@gmail.com
